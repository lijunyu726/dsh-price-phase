{
  "name": "dsh-price-phase",
  "version": "0.1.0",
  "description": "DSH Web GUI 输入卡时段徽标：实时显示 DeepSeek API 处于高峰还是空闲时段（北京时间周一至周五 9:00-12:00 / 14:00-18:00 为高峰，周末全天为空闲半价），并给出距下次切换的倒计时。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./price-phase": {
      "default": "./lib/price-phase.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/price-phase.js",
    "test": "node --test \"test/*.test.js\"",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "deepseek",
    "peak",
    "off-peak",
    "pricing",
    "price",
    "indicator"
  ],
  "author": "lijunyu726",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijunyu726/dsh-price-phase.git"
  },
  "homepage": "https://github.com/lijunyu726/dsh-price-phase#readme",
  "bugs": {
    "url": "https://github.com/lijunyu726/dsh-price-phase/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
