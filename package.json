{
  "name": "dsh-price-phase",
  "version": "0.1.1",
  "description": "输入卡底部工具行的计费时段徽标，附倒计时。高峰为北京时间周一至周五 09:00-12:00、14:00-18:00；周末全天算空闲，周五 18:00 后显示距下周一 09:00 还有 63 小时。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./price-phase": {
      "default": "./lib/price-phase.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:bundle": "node scripts/inline-price-phase.mjs",
    "check:bundle": "node scripts/inline-price-phase.mjs --check",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/price-phase.js && npm run check:bundle",
    "test": "node --test \"test/*.test.js\"",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "deepseek",
    "peak",
    "off-peak",
    "pricing",
    "price",
    "indicator"
  ],
  "author": "lijunyu726",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijunyu726/dsh-price-phase.git"
  },
  "homepage": "https://github.com/lijunyu726/dsh-price-phase#readme",
  "bugs": {
    "url": "https://github.com/lijunyu726/dsh-price-phase/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
